{
  "name": "captab",
  "private": true,
  "packageManager": "pnpm@10.16.1",
  "scripts": {
    "test:contract": "cargo test -p captab-company --lib",
    "test:e2e": "pnpm --filter @captab/web test:e2e",
    "test:vesting": "pnpm --filter @captab/web test:vesting",
    "test:receipts": "pnpm --filter @captab/web test:receipts",
    "test:auth": "pnpm --filter @captab/web test:auth",
    "test:dao": "pnpm --filter @captab/web test:dao",
    "test:health": "pnpm --filter @captab/web test:health",
    "test:hash": "pnpm --filter @captab/web test:hash",
    "test:payments": "pnpm --filter @captab/web test:payments",
    "test:sponsor": "pnpm --filter @captab/web test:sponsor",
    "test:deployment": "pnpm --filter @captab/web test:deployment",
    "test:network": "pnpm --filter @captab/web test:network",
    "test:observation": "pnpm --filter @captab/web test:observation",
    "test:sandbox": "bash scripts/build-sputnik.sh && cargo build -p captab-company -p captab-test-token --target wasm32-unknown-unknown --release && cargo test -p captab-company --test sandbox",
    "build:contract": "cargo build -p captab-company --target wasm32-unknown-unknown --release",
    "deploy:testnet": "pnpm --filter @captab/web deploy:testnet",
    "bootstrap:dao": "pnpm --filter @captab/web bootstrap:dao",
    "bootstrap:token": "pnpm --filter @captab/web bootstrap:token"
  }
}
